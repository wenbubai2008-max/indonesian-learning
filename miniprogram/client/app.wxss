page {
  background: #f7f7f1;
  color: #202d25;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 30rpx;
  line-height: 1.55;
}

view, button, input, scroll-view { box-sizing: border-box; }

.container { max-width: 720px; margin: 0 auto; padding: 28rpx 32rpx 40rpx; }
.card { background: #fff; border: 1rpx solid #dfe5db; border-radius: 24rpx; padding: 26rpx; }
.heading { font-size: 38rpx; line-height: 1.25; font-weight: 700; }
.muted { color: #516258; font-size: 26rpx; }
.status { margin: 30rpx 0 8rpx; text-align: center; }
.problem { color: #923f32; overflow-wrap: break-word; }
.body-text { white-space: pre-wrap; overflow-wrap: break-word; }
button { line-height: 1.3; font-size: 28rpx; margin: 0; }
button::after { border: 0; }
.action { background: #225c43; color: #fff; border-radius: 14rpx; padding: 20rpx 24rpx; }
.secondary { background: #edf4ed; color: #22543e; border-radius: 14rpx; padding: 15rpx 20rpx; }
.action[disabled] { background: #e6e8e2; color: #59655d; }
.secondary[disabled] { background: #e6e8e2; color: #59655d; }
