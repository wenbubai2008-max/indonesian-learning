<view class="lesson container">
  <view class="sticky">
    <view class="muted">练习模式：答题不计入复习，想计入请在网站上做。</view>
    <view wx:if="{{model}}" class="translation-switch">
      <text>全部显示中文</text>
      <switch checked="{{showAll}}" color="#225c43" bindchange="setAll" aria-label="全部显示中文"/>
    </view>
  </view>
  <view wx:if="{{model}}" class="lesson-content">
    <view class="muted meta">{{date}} · {{sessionLabel}}<text wx:if="{{model.time}}"> · {{model.time}}</text></view>
    <view wx:if="{{model.title}}" class="heading lesson-title">{{model.title}}</view>

    <view wx:for="{{model.sections}}" wx:for-item="section" wx:key="title" class="card section">
      <view class="section-title">{{section.title}}</view>
      <scroll-view wx:if="{{section.tags.length}}" scroll-x class="tags">
        <text wx:for="{{section.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
      </scroll-view>
      <view wx:for="{{section.entries}}" wx:key="key" class="entry">
        <view wx:if="{{item.label}}" class="entry-label">{{item.label}}</view>
        <view wx:if="{{item.body}}" class="body-text entry-body">{{item.body}}</view>
        <view wx:if="{{item.example}}" class="body-text example">{{item.example}}</view>
        <view wx:if="{{item.hint}}" class="body-text muted">{{item.hint}}</view>
        <button wx:if="{{(item.cn || item.exampleCn) && !showAll}}" class="detail-action" bindtap="toggleTranslation" data-key="{{item.key}}">
          {{translations[item.key] ? '收起' : (item.translationLabel || '看中文')}}
        </button>
        <view wx:if="{{item.cn && (showAll || translations[item.key])}}" class="body-text translation">{{item.cn}}</view>
        <view wx:if="{{item.exampleCn && (showAll || translations[item.key])}}" class="body-text translation">{{item.exampleCn}}</view>
        <view wx:if="{{item.note}}" class="body-text muted">{{item.note}}</view>

        <button wx:if="{{item.details}}" class="detail-action" bindtap="toggleDetails" data-key="{{item.key}}">
          {{details[item.key] ? '收起词卡' : '展开词卡'}}
        </button>
        <view wx:if="{{item.details && (details[item.key] || showAll)}}" class="details">
          <view wx:for="{{item.details}}" wx:for-item="row" wx:key="label" class="detail-row">
            <view class="muted">{{row.label}}</view>
            <view wx:if="{{row.body}}" class="body-text">{{row.body}}</view>
            <view wx:if="{{row.cn && (showAll || translations[item.key])}}" class="body-text translation">{{row.cn}}</view>
            <button wx:elif="{{row.cn && !item.cn && !item.exampleCn}}" class="detail-action"
              bindtap="toggleTranslation" data-key="{{item.key}}">看中文</button>
          </view>
        </view>

        <view wx:if="{{item.choices}}" class="choices">
          <button wx:for="{{item.choices}}" wx:for-item="option" wx:for-index="optionIndex" wx:key="*this"
            class="choice {{choices[item.key] && item.correct === optionIndex ? 'correct' : ''}} {{choices[item.key] === optionIndex + 1 && item.correct >= 0 && item.correct !== optionIndex ? 'incorrect' : ''}}"
            bindtap="selectChoice" data-key="{{item.key}}" data-index="{{optionIndex}}">
            {{option}}
          </button>
          <view wx:if="{{choices[item.key]}}" class="feedback">
            <view wx:if="{{item.correct >= 0}}" class="{{choices[item.key] === item.correct + 1 ? 'result-good' : 'problem'}}">
              {{choices[item.key] === item.correct + 1 ? '答对了' : '答错了'}}
            </view>
            <view wx:if="{{item.explanation}}" class="body-text">{{item.explanation}}</view>
          </view>
        </view>

        <button wx:if="{{item.answer || item.answerCn}}" class="detail-action" bindtap="toggleAnswer" data-key="{{item.key}}">
          {{answers[item.key] ? '收起' : item.answerLabel}}
        </button>
        <view wx:if="{{answers[item.key]}}" class="feedback">
          <view wx:if="{{item.answer}}" class="body-text">{{item.answer}}</view>
          <view wx:if="{{item.answerCn}}" class="translation body-text">{{item.answerCn}}</view>
          <view wx:if="{{item.explanation}}" class="body-text">{{item.explanation}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{model.otherFields}}" class="status muted">
      <view>本课还有：{{model.otherFields}}，请在网站查看</view>
      <text class="site-url" selectable>{{website}}</text>
      <button class="secondary copy" bindtap="copyWebsite">复制本课地址</button>
    </view>
  </view>
  <view wx:if="{{busy && !model}}" class="status muted">正在读取课程…</view>
  <view wx:if="{{issue}}" class="status problem">{{issue}}</view>
  <view wx:if="{{status}}" class="status muted">{{status}}</view>
</view>
