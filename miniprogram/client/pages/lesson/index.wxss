.lesson { padding-top: 20rpx; }
.lesson-mode { margin-bottom: 16rpx; }
.meta { margin-top: 8rpx; }
.lesson-title { margin: 8rpx 0 24rpx; overflow-wrap: break-word; }

.section { margin: 24rpx 0; }
.section-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 38rpx;
  font-weight: 750;
  line-height: 1.3;
  word-break: break-word;
}
.section-marker {
  display: flex;
  justify-content: center;
  align-items: center;
  flex: 0 0 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: var(--soft);
  color: var(--blue);
  font-size: 26rpx;
}
.section-subtitle { color: var(--muted); font-size: 26rpx; margin-top: 12rpx; }

.entry {
  margin-top: 18rpx;
  padding: 26rpx;
  border: 2rpx solid var(--line);
  border-radius: 26rpx;
  line-height: 1.75;
}
.entry-body { color: #284f83; font-weight: 700; }
.entry-label, .speaker, .entry-group, .root-word { font-weight: 750; }
.entry-group { margin-top: 24rpx; color: var(--blue); }
.translation { margin-top: 8rpx; color: var(--muted); }
.source-label { margin-top: 10rpx; color: var(--blue); font-weight: 750; font-size: 26rpx; }

.focus-section { background: #fffaf1; border-color: #efdcbc; border-radius: 32rpx; padding: 28rpx 32rpx; }
.focus-section .section-title { font-size: 34rpx; }
.focus-section .section-subtitle { color: #7a6a55; margin: 4rpx 0 20rpx; }
.focus-section .entry, .focus-entry { background: #fffcf6; border-color: #ecd2a6; }
.focus-section .entry { background: var(--card); border-color: #efdcbc; padding: 20rpx; }
.focus-tag { margin-left: 8rpx; padding: 2rpx 12rpx; color: var(--warn); background: #fffaf1; border-radius: 12rpx; font-size: 22rpx; }
.series { margin-top: 10rpx; border: 0; padding: 0; font-size: 26rpx; }
.series .entry-body { color: var(--muted); font-weight: 400; }
.story-note { background: #f6f8fc; border-style: dashed; padding: 16rpx 24rpx; }
.reading-entry { border: 0; padding: 0; }
.reading-entry .entry-body {
  background: #f7faff;
  border-left: 8rpx solid #91ace8;
  border-radius: 24rpx;
  padding: 32rpx;
  line-height: 1.9;
}
.reading-translation { background: #f6f8fc; border-radius: 22rpx; padding: 26rpx; }

.word-heading { display: flex; gap: 10rpx; align-items: baseline; flex-wrap: wrap; }
.word-number, .word { font-size: 34rpx; font-weight: 750; overflow-wrap: anywhere; }
.word-number { color: var(--blue); font-size: 27rpx; }
.example, .root, .details, .feedback { margin-top: 12rpx; padding: 16rpx 20rpx; border-radius: 20rpx; background: #f6f8fc; }
.example { color: #284f83; font-weight: 600; }
.example .translation { font-weight: 400; }
.sentence-frame { border: 2rpx dashed #c9d4e6; }
.detail-action { display: block; width: fit-content; margin: 12rpx 0 0; padding: 12rpx 20rpx; font-size: 26rpx; }
.detail-row + .detail-row { margin-top: 12rpx; }

.choice {
  display: block;
  width: 100%;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  text-align: left;
  white-space: normal;
  overflow-wrap: break-word;
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  background: var(--card);
  color: var(--text);
}
.correct { border-color: var(--ok); color: var(--ok); }
.incorrect { border-color: var(--bad); color: var(--bad); background: #fff1f0; }
.result-good { color: var(--ok); }
.site-url { display: block; margin: 8rpx 0; word-break: break-all; }
.copy { margin: 12rpx auto 0; }
