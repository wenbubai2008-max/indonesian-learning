<template name="results">
  <view wx:for="{{rows}}" wx:key="label" class="probe-row">
    <view class="result-head">
      <text class="probe-name">{{item.label}}</text>
      <text class="{{item.ok ? 'pass' : 'problem'}}">{{item.ok ? '成功' : (item.error === '超时' ? '超时' : '失败')}}</text>
    </view>
    <view class="muted metrics">HTTP {{item.status === null ? '—' : item.status}} · {{item.ms === null ? '—' : item.ms + ' ms'}}</view>
    <view wx:if="{{item.error}}" class="muted body-text">{{item.error}}</view>
    <view class="muted body-text">{{item.url}}</view>
  </view>
</template>

<view class="container">
  <view class="card controls">
    <view class="label">只测四个指定 GitHub 地址</view>
    <view class="muted body-text">每个地址单独等待最多 2500 ms；归档地址只读取响应头，不下载文件。</view>
    <button class="action start" bindtap="start" loading="{{running}}" disabled="{{running}}">
      {{running ? '测试中…' : '开始测试'}}
    </button>
  </view>

  <view class="card panel">
    <view class="group-title">云函数连通性</view>
    <view class="muted body-text">云端最近同步：{{syncAt || '尚无同步记录'}}</view>
    <view wx:if="{{cloudError}}" class="body-text problem">云函数不可用 · {{cloudError}}</view>
    <template wx:elif="{{cloudRows.length}}" is="results" data="{{rows: cloudRows}}"/>
    <view wx:else class="muted">{{running ? '测试中…' : '等待测试'}}</view>
  </view>

  <view wx:if="{{localError}}" class="problem status">{{localError}}</view>
  <view class="history-head">
    <view class="heading">测试历史</view>
    <button class="secondary" bindtap="copyAll" disabled="{{!history.length}}">复制全部结果</button>
  </view>
  <view wx:if="{{!history.length}}" class="muted">暂无测试记录</view>
  <view wx:for="{{history}}" wx:for-item="record" wx:key="id" class="card panel">
    <view class="group-title">{{record.date}} · 雅加达</view>
    <template is="results" data="{{rows: record.rows}}"/>
  </view>
</view>
