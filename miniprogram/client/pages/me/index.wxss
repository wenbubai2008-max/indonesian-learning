@import '../today/index.wxss';
.stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; }
.stat { padding: 18rpx 5rpx; text-align: center; }
.stat-number { font-size: 45rpx; font-weight: 750; color: #2445b7; }
.calendar { padding: 18rpx; }
.calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 3rpx; }
.weekday { text-align: center; padding: 10rpx 0; }
.day, .month-button { width: 100%; background: white; color: var(--text); border: 2rpx solid transparent; padding: 0; }
.day { border-radius: 16rpx; }
.day.today { border-color: #172033; }
.day.chosen-day { background: var(--soft); }
.month-button { width: 88rpx; font-size: 46rpx; }
.month-button[disabled] { color: var(--muted); background: white; opacity: .45; }
.dots { display: flex; justify-content: center; gap: 7rpx; padding: 7rpx 0; }
.dot { width: 11rpx; height: 11rpx; border-radius: 50%; background: #cbd1dd; }
.dot.published { background: var(--blue); }
.date-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; margin-top: 18rpx; }
.date-options button { padding: 8rpx; font-size: 25rpx; }
.settings { padding-top: 0; padding-bottom: 0; }
.settings-row { display: flex; justify-content: space-between; align-items: center; width: 100%; min-height: 88rpx; padding: 10rpx 0; background: white; border-bottom: 2rpx solid var(--line); color: var(--text); font-size: 29rpx; }
.settings-row:last-child { border-bottom: 0; }
.settings-row text { color: var(--muted); }
.site-hint { padding: 24rpx; border-radius: 26rpx; background: var(--secondary); }
